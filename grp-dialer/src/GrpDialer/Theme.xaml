<!--
  Dark theme. Values mirror the Huronia admin-panel design tokens
  (Website repo: admin/src/styles/tokens.css) so the two read as one family.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tokens -->
    <Color x:Key="BgColor">#0D1117</Color>
    <Color x:Key="BgCardColor">#111720</Color>
    <Color x:Key="BgUiColor">#1C2333</Color>
    <Color x:Key="AccentColor">#5B6A8C</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BgCard" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgUi" Color="{StaticResource BgUiColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E2E8F0" />
    <SolidColorBrush x:Key="TextDim" Color="#BFE2E8F0" />
    <SolidColorBrush x:Key="TextFaint" Color="#8CCBD5E1" />
    <SolidColorBrush x:Key="Border" Color="#1CD8E7F2" />
    <SolidColorBrush x:Key="BorderStrong" Color="#33D8E7F2" />
    <SolidColorBrush x:Key="GlowInset" Color="#2ECFE7FF" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="#4A5878" />
    <SolidColorBrush x:Key="AccentBg" Color="#265B6A8C" />
    <SolidColorBrush x:Key="Success" Color="#00FF88" />
    <SolidColorBrush x:Key="SuccessBg" Color="#1F00FF88" />
    <SolidColorBrush x:Key="SuccessBorder" Color="#3300FF88" />
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />
    <SolidColorBrush x:Key="DangerBg" Color="#1FFF4444" />
    <SolidColorBrush x:Key="DangerBorder" Color="#4DFF4444" />
    <SolidColorBrush x:Key="Warn" Color="#FBBF24" />
    <SolidColorBrush x:Key="WarnBg" Color="#24F59E0B" />
    <SolidColorBrush x:Key="Info" Color="#60A5FA" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <CornerRadius x:Key="Radius">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">16</CornerRadius>

    <!-- Card: bg-card, 1px border, inset top glow -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BgUi}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource BtnBase}" />

    <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource SuccessBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorder}" />
        <Setter Property="Foreground" Value="{StaticResource Success}" />
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource DangerBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
        <Setter Property="Foreground" Value="{StaticResource Danger}" />
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="Key" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Inputs -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PasswordInput" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Bg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="30" Height="17" CornerRadius="9"
                                Background="{StaticResource BgUi}" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="11" Height="11" Margin="2,0"
                                     HorizontalAlignment="Left" Fill="{StaticResource TextFaint}" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill badge (mirrors .badge b-*) -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="100" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>
