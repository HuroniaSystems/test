<Window x:Class="GrpDialer.CallBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GRP Dialer call"
        Width="364" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource Ink}"
        UseLayoutRounding="True">

    <!-- Thin call strip, same width as the dialer. Stays up for the whole call. -->
    <Grid Margin="12">
        <Border CornerRadius="12" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.3" Color="Black" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12" Background="White" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                Padding="14,9,9,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Number (click opens the dialer) -->
                <StackPanel x:Name="Who" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonUp="Who_Click">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Dot" Width="9" Height="9" VerticalAlignment="Center" Margin="0,1,9,0"
                                 Fill="{StaticResource RingDot}" />
                        <TextBlock x:Name="NumberText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Text="(705) 555-1234" />
                    </StackPanel>
                    <TextBlock x:Name="Caption" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="18,1,0,0"
                               Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button x:Name="AnswerBtn" Style="{StaticResource PrimaryButton}" Height="32" Padding="11,0"
                            Click="Answer_Click" ToolTip="Answer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE717;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Answer" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeclineBtn" Style="{StaticResource DangerButton}" Height="32" Padding="11,0" Margin="6,0,0,0"
                            Click="Decline_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE778;" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock x:Name="DeclineText" Text="Decline" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
