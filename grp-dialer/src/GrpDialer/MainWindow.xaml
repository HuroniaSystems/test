<Window x:Class="GrpDialer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GRP Dialer"
        Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="CanMinimize"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="16,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="GRP Dialer" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{StaticResource TextFaint}" />
                    <TextBlock x:Name="ConnText" Text="Not configured" Margin="6,0,0,0" FontSize="11"
                               Foreground="{StaticResource TextFaint}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsBtn" Content="Settings" Style="{StaticResource BtnGhost}"
                            Click="Settings_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#x2013;" Style="{StaticResource BtnGhost}" ToolTip="Minimize"
                            Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#x00D7;" Style="{StaticResource BtnGhost}" ToolTip="Close"
                            FontSize="15" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- Dialer view -->
            <StackPanel x:Name="DialerView" Grid.Row="1" Margin="16,4,16,16">

                <!-- Call status card -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Border x:Name="StateBadge" Style="{StaticResource Badge}" HorizontalAlignment="Left"
                                    Background="{StaticResource BgUi}" BorderBrush="{StaticResource Border}">
                                <TextBlock x:Name="StateText" Text="Idle" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDim}" />
                            </Border>
                            <TextBlock x:Name="TimerText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFont}" FontSize="13"
                                       Foreground="{StaticResource TextDim}" />
                        </Grid>
                        <TextBlock x:Name="RemoteName" Text="No active call" Margin="0,12,0,0" FontSize="18"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="RemoteNumber" Margin="0,2,0,0" FontFamily="{StaticResource MonoFont}"
                                   FontSize="13" Foreground="{StaticResource TextDim}" />
                    </StackPanel>
                </Border>

                <!-- Number input -->
                <Grid Margin="0,14,0,0">
                    <TextBox x:Name="NumberBox" Style="{StaticResource Input}"
                             FontFamily="{StaticResource MonoFont}" FontSize="22" Padding="14,10"
                             TextChanged="NumberBox_TextChanged" />
                    <TextBlock x:Name="NumberHint" Text="Enter number" IsHitTestVisible="False"
                               Margin="17,0,0,0" VerticalAlignment="Center" FontSize="15"
                               Foreground="{StaticResource TextFaint}" />
                </Grid>

                <!-- Keypad -->
                <UniformGrid x:Name="Keypad" Columns="3" Margin="-3,10,-3,0">
                    <Button Style="{StaticResource Key}" Content="1" Click="Key_Click" />
                    <Button Style="{StaticResource Key}" Content="2" Click="Key_Click" />
                    <Button Style="{StaticResource Key}" Content="3" Click="Key_Click" />
                    <Button Style="{StaticResource Key}" Content="4" Click="Key_Click" />
                    <Button Style="{StaticResource Key}" Content="5" Click="Key_Click" />
                    <Button Style="{StaticResource Key}" Content="6" Click="Key_Click" />
                    <Button Style="{StaticResource Key}" Content="7" Click="Key_Click" />
                    <Button Style="{StaticResource Key}" Content="8" Click="Key_Click" />
                    <Button Style="{StaticResource Key}" Content="9" Click="Key_Click" />
                    <Button Style="{StaticResource Key}" Content="*" Click="Key_Click" />
                    <Button Style="{StaticResource Key}" Content="0" Click="Key_Click" />
                    <Button Style="{StaticResource Key}" Content="#" Click="Key_Click" />
                </UniformGrid>

                <!-- Actions -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PrimaryBtn" Grid.Column="0" Content="Call" Style="{StaticResource BtnSuccess}"
                            Padding="0,12" FontSize="14" Click="Primary_Click" />
                    <Button x:Name="HangUpBtn" Grid.Column="2" Content="Hang up" Style="{StaticResource BtnDanger}"
                            Padding="0,12" FontSize="14" Click="HangUp_Click" />
                </Grid>

                <TextBlock x:Name="ErrorText" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource Danger}" Visibility="Collapsed" />

                <TextBlock Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextFaint}"
                           Text="Numpad Enter focuses the dialer. Enter calls when idle; during a call it answers if ringing, otherwise hangs up. Esc clears." />
            </StackPanel>

            <!-- Settings view -->
            <StackPanel x:Name="SettingsView" Grid.Row="1" Margin="16,4,16,16" Visibility="Collapsed">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="PHONE IP ADDRESS" />
                        <TextBox x:Name="HostBox" Style="{StaticResource Input}" />

                        <TextBlock Style="{StaticResource Label}" Text="PHONE PASSWORD (admin or user)" Margin="0,12,0,6" />
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordInput}" />

                        <CheckBox x:Name="HttpsCheck" Style="{StaticResource Check}" Content="Use HTTPS"
                                  Margin="0,14,0,4" />
                        <CheckBox x:Name="GlobalKeyCheck" Style="{StaticResource Check}"
                                  Content="Numpad Enter works from any app" />
                        <CheckBox x:Name="PopCheck" Style="{StaticResource Check}"
                                  Content="Bring to front when a call starts on the phone" />
                        <CheckBox x:Name="TopCheck" Style="{StaticResource Check}" Content="Always on top" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="SettingsMsg" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Test" Style="{StaticResource Btn}" Click="Test_Click" />
                    <Button Grid.Column="2" Content="Cancel" Style="{StaticResource Btn}" Click="Cancel_Click" />
                    <Button Grid.Column="4" Content="Save" Style="{StaticResource BtnAccent}" Click="Save_Click" />
                </Grid>

                <TextBlock Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextFaint}"
                           Text="Phone web UI: Network &gt; Remote Control. Enable Action URI Support, add this PC's IP (or any) to the Allowed IP List, and disable Remote Control Pop-up Window Support." />
            </StackPanel>
        </Grid>
    </Border>
</Window>
