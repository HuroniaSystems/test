<Window x:Class="GrpDialer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GrpDialer"
        Title="GRP Dialer"
        Width="364" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource Ink}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- 12px transparent margin holds the shadow, like the OTC Monitor flyouts -->
    <Grid Margin="12">
        <Border CornerRadius="12" Background="{StaticResource Bg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.3" Color="Black" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="12" Background="{StaticResource Bg}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
            <DockPanel>

                <!-- Header: title, connection status, settings / minimize / close -->
                <Border x:Name="Header" DockPanel.Dock="Top" Background="{StaticResource Brand}" CornerRadius="11,11,0,0">
                    <Grid Margin="16,9,8,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HeaderTitle" Text="GRP Dialer" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                            <!-- Only when something's wrong: "Failed to connect", "Wrong password", "Not set up" -->
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" x:Name="ConnPanel" Background="Transparent"
                                        Visibility="Collapsed">
                                <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="#FF9B9B" VerticalAlignment="Center" />
                                <TextBlock x:Name="ConnText" Margin="6,0,0,0" FontSize="12" Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SettingsBtn" Style="{StaticResource HeaderButton}" ToolTip="Settings" Click="Settings_Click">
                                <local:Ico x:Name="SettingsGlyph" Data="{x:Static local:Icons.Settings}" Size="18" />
                            </Button>
                            <Button x:Name="CloseBtn" Style="{StaticResource HeaderButton}" ToolTip="Hide (Esc). GRP Dialer keeps running in the tray." Click="Close_Click">
                                <local:Ico Data="{x:Static local:Icons.Close}" Size="18" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid>
                    <!-- ================= Dialer ================= -->
                    <StackPanel x:Name="DialerView" Margin="14,14,14,14">

                        <!-- Call card -->
                        <Border x:Name="CallCard" Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="RemoteName" Text="No active call" FontSize="20" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border x:Name="StatePill" Grid.Column="1" Style="{StaticResource Pill}" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <!-- Tabular digits so the badge doesn't wobble as the time ticks -->
                                        <TextBlock x:Name="StateText" Text="Ready" FontSize="12" FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular" />
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="RemoteNumber" Margin="0,2,0,0" FontSize="14" Visibility="Collapsed"
                                           Foreground="{StaticResource Muted}" />
                                <!-- PropelRx caller lookup: "Potentially JANE DOE" / "Multiple linked profiles" -->
                                <TextBlock x:Name="CallerText" Margin="0,3,0,0" FontSize="11.5" Visibility="Collapsed"
                                           Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis"
                                           ToolTip="From PropelRx patient phone numbers" />
                            </StackPanel>
                        </Border>

                        <!-- Number entry -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NumberBox" FontSize="20" Height="50" Padding="12,0"
                                     Tag="Type a number" TextChanged="NumberBox_TextChanged" />
                            <Button x:Name="QueueBtn" Grid.Column="1" Margin="8,0,0,0" Height="50" Padding="14,0"
                                    Visibility="Collapsed" Click="Queue_Click" ToolTip="Dial this after the current call (Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <local:Ico Data="{x:Static local:Icons.Plus}" Size="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Queue" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Keypad (hidden unless turned on) -->
                        <UniformGrid x:Name="Keypad" Columns="3" Margin="-3,8,-3,0" Visibility="Collapsed">
                            <Button Style="{StaticResource Key}" Content="1" Click="Key_Click" />
                            <Button Style="{StaticResource Key}" Content="2" Click="Key_Click" />
                            <Button Style="{StaticResource Key}" Content="3" Click="Key_Click" />
                            <Button Style="{StaticResource Key}" Content="4" Click="Key_Click" />
                            <Button Style="{StaticResource Key}" Content="5" Click="Key_Click" />
                            <Button Style="{StaticResource Key}" Content="6" Click="Key_Click" />
                            <Button Style="{StaticResource Key}" Content="7" Click="Key_Click" />
                            <Button Style="{StaticResource Key}" Content="8" Click="Key_Click" />
                            <Button Style="{StaticResource Key}" Content="9" Click="Key_Click" />
                            <Button Style="{StaticResource Key}" Content="*" Click="Key_Click" />
                            <Button Style="{StaticResource Key}" Content="0" Click="Key_Click" />
                            <Button Style="{StaticResource Key}" Content="#" Click="Key_Click" />
                        </UniformGrid>

                        <!-- Actions: one big button when idle, Answer / Hang up during a call -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AnswerCol" Width="*" />
                                <ColumnDefinition x:Name="GapCol" Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CallBtn" Grid.ColumnSpan="3" Style="{StaticResource PrimaryButton}"
                                    Height="46" FontSize="15" Click="Call_Click">
                                <StackPanel Orientation="Horizontal">
                                    <local:Ico Data="{x:Static local:Icons.Phone}" Size="17" Margin="0,0,8,0" />
                                    <TextBlock x:Name="CallBtnText" Text="Call" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="AnswerBtn" Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                    Height="46" FontSize="15" Click="Answer_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <local:Ico Data="{x:Static local:Icons.Phone}" Size="17" Margin="0,0,8,0" />
                                    <TextBlock Text="Answer" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="HangUpBtn" Grid.Column="2" Style="{StaticResource DangerButton}"
                                    Height="46" FontSize="15" Click="HangUp_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <local:Ico Data="{x:Static local:Icons.HangUp}" Size="20" Margin="0,0,8,0" />
                                    <TextBlock Text="Hang up" />
                                </StackPanel>
                            </Button>
                            <!-- Hold / resume: small square beside Hang up -->
                            <Button x:Name="HoldBtn" Grid.Column="3" Width="46" Height="46" Padding="0" Margin="8,0,0,0"
                                    Visibility="Collapsed" Click="Hold_Click" ToolTip="Hold">
                                <local:Ico x:Name="HoldIcon" Data="{x:Static local:Icons.Pause}" Size="18" />
                            </Button>
                        </Grid>

                        <!-- Message (errors, setup prompt) -->
                        <Border x:Name="MsgPanel" Margin="0,10,0,0" Padding="12,9" CornerRadius="8"
                                Background="{StaticResource DangerBg}" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MessageText" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{StaticResource DangerInk}" />
                                <Button x:Name="MessageAction" Grid.Column="1" Style="{StaticResource LinkButton}" Margin="8,-2,-4,-2"
                                        Visibility="Collapsed" Click="MessageAction_Click" />
                            </Grid>
                        </Border>

                        <!-- Up next: only while numbers are waiting -->
                        <Border x:Name="QueuePanel" Style="{StaticResource CardBox}" Margin="0,12,0,0" Padding="12,10,8,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="QueueTitle" Text="Up next" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PauseBtn" Style="{StaticResource LinkButton}" Content="Pause" Click="Pause_Click" />
                                        <Button x:Name="ClearQueueBtn" Style="{StaticResource LinkButton}" Content="Clear" Click="ClearQueue_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="QueueStatus" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <ItemsControl x:Name="QueueList" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="row" CornerRadius="6" Padding="8,4,0,4" Margin="-4,0,0,0" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Position}" FontSize="12" Foreground="{StaticResource Faint}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="14"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Button Grid.Column="2" Style="{StaticResource QuietButton}" ToolTip="Remove"
                                                            Click="RemoveQueued_Click">
                                                        <local:Ico Data="{x:Static local:Icons.Close}" Size="13" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background" Value="{StaticResource Hover}" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Footer: keypad toggle + quiet tip -->
                        <Grid Margin="0,8,0,-4">
                            <StackPanel x:Name="TipPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Kbd}">
                                    <TextBlock Style="{StaticResource KbdText}" Text="ENTER" />
                                </Border>
                                <TextBlock x:Name="TipText" Style="{StaticResource Hint}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}" Text="Call" />
                            </StackPanel>
                            <Button x:Name="KeypadBtn" HorizontalAlignment="Right" Style="{StaticResource LinkButton}"
                                    Click="KeypadToggle_Click" Margin="0,0,-6,0">
                                <StackPanel Orientation="Horizontal">
                                    <local:Ico Data="{x:Static local:Icons.Dialpad}" Size="13" Margin="0,0,6,0" />
                                    <TextBlock x:Name="KeypadBtnText" Text="Keypad" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Phone unreachable: dim the dialer and block it (Settings stays reachable in the header) -->
                    <Border x:Name="Blocker" Background="{StaticResource Bg}" Opacity="0" Visibility="Collapsed"
                            CornerRadius="0,0,11,11" />

                    <!-- ================= Settings ================= -->
                    <StackPanel x:Name="SettingsView" Margin="14" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Text="Phone" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Style="{StaticResource Label}" Text="Phone address" />
                                <TextBox x:Name="HostBox" Tag="e.g. 192.168.1.50" />
                                <TextBlock Style="{StaticResource Label}" Text="Phone password" Margin="0,10,0,5" />
                                <PasswordBox x:Name="PasswordBox" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="TestBtn" Content="Test connection" Click="Test_Click" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Ellipse x:Name="TestDot" Width="8" Height="8" Margin="0,0,6,0" Visibility="Collapsed" />
                                        <TextBlock x:Name="TestText" FontSize="12" TextWrapping="Wrap" MaxWidth="170" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Caller lookup" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Shows who might be calling, from PropelRx patient phone numbers." />
                                <TextBlock Style="{StaticResource Label}" Text="PropelRx server" />
                                <TextBox x:Name="PropelBox" Tag="e.g. svr1 · leave blank to turn off" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PropelTestBtn" Content="Test lookup" Click="PropelTest_Click" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Ellipse x:Name="PropelTestDot" Width="8" Height="8" Margin="0,0,6,0" Visibility="Collapsed" />
                                        <TextBlock x:Name="PropelTestText" FontSize="12" TextWrapping="Wrap" MaxWidth="170" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Options" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <CheckBox x:Name="GlobalKeyCheck" Content="Numpad Enter opens the dialer" />
                                <CheckBox x:Name="ClickAwayCheck" Content="Hide when I click away" />
                                <CheckBox x:Name="KeypadCheck" Content="Show keypad" />
                            </StackPanel>
                        </Border>

                        <!-- Advanced: tucked away -->
                        <Button x:Name="AdvancedBtn" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                Margin="-4,10,0,0" Click="Advanced_Click">
                            <StackPanel Orientation="Horizontal">
                                <local:Ico x:Name="AdvancedGlyph" Data="{x:Static local:Icons.ChevronRight}" Size="14" Margin="0,0,4,0" />
                                <TextBlock Text="Advanced and help" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="AdvancedPanel" Style="{StaticResource CardBox}" Margin="0,6,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <CheckBox x:Name="HttpsCheck" Content="Connect with HTTPS" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Seconds before the next queued call" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBox x:Name="DelayBox" Grid.Column="1" Width="56" HorizontalContentAlignment="Center" />
                                </Grid>

                                <TextBlock Style="{StaticResource Label}" Text="PropelRx Windows account" Margin="0,14,0,2" />
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Only if PropelRx asks for a sign-in. Blank uses this Windows user." />
                                <TextBox x:Name="PropelUserBox" Tag="DOMAIN\username" />
                                <PasswordBox x:Name="PropelPasswordBox" Margin="0,6,0,0" />

                                <TextBlock Style="{StaticResource Label}" Text="Keys" Margin="0,14,0,4" />
                                <TextBlock Style="{StaticResource Hint}" LineHeight="18">
                                    <Run FontWeight="SemiBold" Foreground="{StaticResource Ink}">Enter</Run> calls the number. During a call it queues the typed number; with nothing typed it answers, or hangs up.
                                    <LineBreak />
                                    <Run FontWeight="SemiBold" Foreground="{StaticResource Ink}">Numpad Enter</Run> brings the dialer up from any app.
                                    <LineBreak />
                                    <Run FontWeight="SemiBold" Foreground="{StaticResource Ink}">Esc</Run> clears the number, then hides the dialer.
                                    <LineBreak />
                                    The dialer lives in the tray by the clock: click its icon to open it, right-click to quit.
                                </TextBlock>

                                <TextBlock Style="{StaticResource Label}" Text="Phone setup (GRP26xx)" Margin="0,14,0,4" />
                                <TextBlock Style="{StaticResource Hint}" LineHeight="18"
                                           Text="In the phone's web page, open Network › Remote Control. Turn on Action URI Support, add this PC's IP (or any) to the Allowed IP List, and turn off Remote Control Pop-up Window Support. On GRP260x also turn on Click-To-Dial (Phone Settings › Call Settings)." />
                                <Grid Margin="0,12,0,0">
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                                    <Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Margin="0,0,-6,0"
                                            Content="Quit GRP Dialer" Click="Quit_Click"
                                            ToolTip="Stops the app. Also in the tray icon's right-click menu." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CancelBtn" Content="Cancel" Height="40" Click="Cancel_Click" />
                            <Button Grid.Column="2" Content="Save" Height="40" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                        </Grid>
                        <TextBlock x:Name="SettingsMsg" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource DangerInk}" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
